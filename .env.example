# Runtime lane: development | preview | production
EXPO_PUBLIC_APP_ENV=development

# Mobile/public configuration only. Never place a service_role or sb_secret_* key here.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY

# Trusted server endpoint that receives { imageBase64, mimeType } and returns a structured RecipeDraft.
# Leave empty during local/demo development. HTTPS only.
EXPO_PUBLIC_RECIPE_OCR_ENDPOINT=

# Trusted server endpoint that receives { imageBase64, mimeType } and returns visible pantry items.
# Mobile clients never receive a provider secret. HTTPS only.
EXPO_PUBLIC_PANTRY_VISION_ENDPOINT=

# Trusted authenticated account-deletion endpoint. For the prepared Supabase lane, use the deployed
# delete-account Edge Function URL: https://<project-ref>.supabase.co/functions/v1/delete-account
# Privileged Supabase credentials remain inside the Edge Function environment. HTTPS only.
EXPO_PUBLIC_ACCOUNT_DELETION_ENDPOINT=


# RevenueCat public SDK configuration for production billing.
# These keys are public platform SDK keys (Apple appl_* / Google goog_*), never RevenueCat sk_* secret keys.
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=
EXPO_PUBLIC_REVENUECAT_ENTITLEMENT_ID=family

# Store/privacy compliance. Production requires all three HTTPS URLs.
EXPO_PUBLIC_PRIVACY_POLICY_URL=
EXPO_PUBLIC_ACCOUNT_DELETION_WEB_URL=

# Server-side live-smoke expectation (never EXPO_PUBLIC). On production-like staging, set true.
# EXPECT_PREMIUM_ENFORCEMENT=true

# Keep blank until the authenticated Supabase Edge Function commander-search is deployed and GOOGLE_MAPS_API_KEY is set server-side.
EXPO_PUBLIC_COMMANDER_LIVE_PROVIDER=
